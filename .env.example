# 1. Copia este archivo y renómbralo como .env (en esta misma carpeta)
# 2. Pega tu llave de https://platform.claude.com (sección API Keys)
ANTHROPIC_API_KEY=pega-aqui-tu-llave

# Ejecutor: el modelo que resuelve las tareas. Conviene uno pequeño:
# Harness² brilla cuando el modelo tiene margen de mejora.
MODELO_EJECUTOR=claude-haiku-5-5

# Editor/compositor/reflector: el modelo que mejora el harness.
MODELO_EDITOR=claude-sonnet-5-5
